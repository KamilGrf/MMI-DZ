+    assert.equal(drill.days_in_use, 10);
+    assert.equal(all.data[0].tool_id, 1); // сортировка по days_in_use по убыванию
+    const unused = all.data.find((r) => r.tool_id === 14);
+    assert.equal(unused.issues_count, 0);
+    assert.equal(unused.last_issued_at, null);
+
+    const cat = await call('GET', '/api/report/usage?category=1');
+    assert.ok(cat.data.length > 0 && cat.data.every((r) => r.category === 'Электроинструмент'));
+
+    assert.equal((await call('GET', '/api/report/usage?category=abc')).status, 400);
